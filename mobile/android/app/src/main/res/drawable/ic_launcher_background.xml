<?xml version="1.0" encoding="utf-8"?>
<!-- Adaptive-icon background layer: HOP's indigo-violet, as a subtle
     top-left-to-bottom-right gradient rather than a flat fill so the icon
     reads with some depth against both light and dark launcher wallpapers.
     Drawn at the full 108x108 viewport (NOT the 66x66 safe zone) — the
     background layer is expected to bleed to the edges, since the launcher
     masks and can parallax-shift it. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path android:pathData="M0,0 h108 v108 h-108 z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="0"
                android:startY="0"
                android:endX="108"
                android:endY="108">
                <item android:offset="0" android:color="#FF6E5FF0" />
                <item android:offset="1" android:color="#FF4A3ED6" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
