<?xml version="1.0" encoding="utf-8"?>
<!-- Identical to ic_launcher.xml: an adaptive icon is masked to whatever
     shape the launcher wants (circle, squircle, rounded square), so there is
     nothing round-specific to draw here. It exists only because
     android:roundIcon in the manifest needs a target on launchers that ask
     for one; both point at the same three layers by design. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@drawable/ic_launcher_background" />
    <foreground android:drawable="@drawable/ic_launcher_foreground" />
    <monochrome android:drawable="@drawable/ic_launcher_monochrome" />
</adaptive-icon>
